# =============================================================================
# GreenPulse AI — Environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# IBM watsonx.ai credentials
# Obtain your API key from: IBM Cloud → IAM → API Keys
# https://cloud.ibm.com/iam/apikeys
# -----------------------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_REGION=us-south

# -----------------------------------------------------------------------------
# IBM Granite model
# Primary: ibm/granite-4-h-small   (fast, efficient)
# Override with WATSONX_MODEL_ID if granite-4-h-small is unavailable
# in your Runtime.  GRANITE_MODEL_ID is also accepted as an alias.
# -----------------------------------------------------------------------------
WATSONX_MODEL_ID=ibm/granite-4-h-small

# -----------------------------------------------------------------------------
# AI execution mode
#   ibm        — always call IBM Granite (returns error if unavailable)
#   simulation — deterministic local stub responses (no IBM call, good for dev)
#   hybrid     — IBM Granite when available, simulation fallback otherwise
# -----------------------------------------------------------------------------
AI_MODE=hybrid

# -----------------------------------------------------------------------------
# Weather API
# Leave blank to use Open-Meteo (free, no key required)
# -----------------------------------------------------------------------------
WEATHER_API_KEY=

# -----------------------------------------------------------------------------
# Database (not required for Milestone 1 — in-memory simulation only)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://greenpulse:greenpulse@localhost:5432/greenpulse

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_SECRET_KEY=change_this_to_a_long_random_string
APP_ENV=development
LOG_LEVEL=INFO

# Data source mode: LIVE | SIMULATED | HISTORICAL
DATA_SOURCE_MODE=SIMULATED
